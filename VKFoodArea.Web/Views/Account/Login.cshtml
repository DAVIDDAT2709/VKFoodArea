@model VKFoodArea.Web.ViewModels.AdminLoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập quản trị - VK Food Area</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page auth-page--admin">
    <main class="admin-login-shell" aria-label="Đăng nhập khu vực quản trị">
        <section class="admin-login-hero" aria-label="VK Food Area Admin">
            <img class="admin-login-hero__image"
                 src="/uploads/site/admin-login-vinh-khanh-gate.jpg"
                 alt="Cổng phố ẩm thực Vĩnh Khánh về đêm"
                 loading="eager" />
            <div class="admin-login-hero__shade" aria-hidden="true"></div>

            <div class="admin-login-brand">
                <span class="admin-login-logo">VK</span>
                <div>
                    <strong>VK Food Area</strong>
                    <span>Admin Console</span>
                </div>
            </div>

            <div class="admin-login-copy" aria-label="Thông tin hệ thống">
                <p class="admin-login-kicker">Quản trị nội dung</p>
                <h1>Điều hành dữ liệu ẩm thực Vĩnh Khánh.</h1>
                <p>Không gian làm việc dành cho đội quản trị VK Food Area.</p>
            </div>

            <div class="admin-login-signal" aria-label="Khu vực vận hành">
                <span>POI</span>
                <span>Tour</span>
                <span>QR</span>
                <span>Map</span>
            </div>
        </section>

        <section class="admin-login-panel" aria-label="Form đăng nhập admin">
            <div class="admin-login-panel__head">
                <span class="admin-login-eyebrow">Bảo mật quản trị</span>
                <h2>Đăng nhập</h2>
                <p>Sử dụng tài khoản được cấp để tiếp tục.</p>
            </div>

            <form asp-action="Login" method="post" class="admin-login-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="auth-field">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username"
                           class="form-control"
                           autocomplete="username"
                           autofocus
                           placeholder="Nhập tài khoản" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <div class="auth-field__label-row">
                        <label asp-for="Password" class="form-label"></label>
                        <button type="button"
                                class="password-toggle"
                                aria-controls="Password"
                                aria-pressed="false"
                                data-password-toggle>
                            Hiện
                        </button>
                    </div>
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="admin-login-options">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                </div>

                <button type="submit" class="auth-submit">Đăng nhập</button>
            </form>
        </section>
    </main>

    <script>
        (() => {
            const toggle = document.querySelector('[data-password-toggle]');
            const password = document.getElementById('Password');

            if (!toggle || !password) {
                return;
            }

            toggle.addEventListener('click', () => {
                const shouldShow = password.type === 'password';
                password.type = shouldShow ? 'text' : 'password';
                toggle.textContent = shouldShow ? 'Ẩn' : 'Hiện';
                toggle.setAttribute('aria-pressed', String(shouldShow));
            });
        })();
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
