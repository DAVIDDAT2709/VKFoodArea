@model VKFoodArea.Web.ViewModels.AdminUserIndexViewModel
@using VKFoodArea.Web.Models
@{
    ViewData["Title"] = "Tài khoản hệ thống";
    var users = Model.Items.Items;
    var logs = Model.RecentAuditLogs;
}

<section class="page-header page-section">
    <div>
        <h2>Tài khoản hệ thống</h2>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Thêm tài khoản</a>
    </div>
</section>

<section class="metrics-grid page-section">
    <article class="metric-card metric-card--blue">
        <span class="metric-card__label">Tổng tài khoản</span>
        <strong class="metric-card__value">@Model.TotalCount</strong>
    </article>
    <article class="metric-card metric-card--green">
        <span class="metric-card__label">Đang hoạt động</span>
        <strong class="metric-card__value">@Model.ActiveCount</strong>
    </article>
    <article class="metric-card metric-card--red">
        <span class="metric-card__label">Đang khóa</span>
        <strong class="metric-card__value">@Model.LockedCount</strong>
    </article>
    <article class="metric-card metric-card--orange">
        <span class="metric-card__label">Admin</span>
        <strong class="metric-card__value">@Model.AdminCount</strong>
    </article>
    <article class="metric-card metric-card--blue">
        <span class="metric-card__label">Chủ nhà hàng</span>
        <strong class="metric-card__value">@Model.OwnerCount</strong>
    </article>
</section>

<section class="card-surface page-section">
    <div class="section-heading">
        <div>
            <h2>Tìm kiếm và lọc</h2>
        </div>
    </div>

    <form method="get" class="search-grid">
        <div class="search-grid__wide">
            <label asp-for="Query" class="form-label">Từ khóa</label>
            <input asp-for="Query" class="form-control" placeholder="Tên đăng nhập hoặc tên hiển thị" />
        </div>
        <div>
            <label asp-for="Role" class="form-label">Vai trò</label>
            <select asp-for="Role" class="form-select">
                <option value="">Tất cả</option>
                <option value="Admin">Admin</option>
                <option value="RestaurantOwner">Chủ nhà hàng</option>
            </select>
        </div>
        <div>
            <label asp-for="Status" class="form-label">Trạng thái</label>
            <select asp-for="Status" class="form-select">
                <option value="">Tất cả</option>
                <option value="active">Đang hoạt động</option>
                <option value="locked">Đang khóa</option>
            </select>
        </div>
        <div class="search-actions">
            <button type="submit" class="btn btn-primary">Áp dụng</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>
</section>

<section class="card-surface page-section">
    <div class="section-heading">
        <div>
            <h2>Danh sách tài khoản</h2>
        </div>
    </div>

    @if (!users.Any())
    {
        <div class="empty-state">
            <p class="mb-0">Chưa có tài khoản phù hợp.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tài khoản</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>POI sở hữu</th>
                        <th>Đăng nhập gần nhất</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in users)
                    {
                        <tr>
                            <td>
                                <div class="table-title">@item.Username</div>
                                <div class="table-meta">@item.FullName</div>
                            </td>
                            <td>
                                <span class="soft-pill soft-pill--neutral">@AdminRoleNames.DisplayName(item.Role)</span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill status-pill--success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--muted">Đang khóa</span>
                                }
                            </td>
                            <td>@item.OwnedPoiCount</td>
                            <td>
                                @(item.LastLoginAt.HasValue
                                    ? WebDisplayTime.Format(item.LastLoginAt.Value, "dd/MM/yyyy HH:mm")
                                    : "Chưa đăng nhập")
                            </td>
                            <td class="text-end">
                                <div class="table-actions justify-content-end">
                                    <form asp-action="ResetPassword" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Reset mật khẩu tài khoản này về 123456?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Reset MK</button>
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="@(VKFoodArea.Web.ViewModels.PaginationViewModel.From(Model.Items))" />
    }
</section>

<section class="card-surface page-section">
    <div class="section-heading">
        <div>
            <h2>Lịch sử thao tác gần nhất</h2>
        </div>
    </div>

    @if (!logs.Any())
    {
        <div class="empty-state">
            <p class="mb-0">Chưa có audit log.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Người thao tác</th>
                        <th>Hành động</th>
                        <th>Nội dung</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in logs)
                    {
                        <tr>
                            <td>@WebDisplayTime.Format(log.CreatedAt, "dd/MM/yyyy HH:mm")</td>
                            <td>@log.ActorUsername</td>
                            <td>
                                <span class="soft-pill soft-pill--neutral">@log.ActionLabel</span>
                            </td>
                            <td>@log.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>