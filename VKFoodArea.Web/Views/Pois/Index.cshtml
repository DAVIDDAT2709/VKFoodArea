@model VKFoodArea.Web.ViewModels.PoiIndexViewModel
@using VKFoodArea.Web.Models
@using VKFoodArea.Web.Services
@{
    ViewData["Title"] = "Quản lý POI";
    var pois = Model.Items;
}

<section class="page-header page-section">
    <div>
        <h2>Quản lý POI</h2>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Thêm POI</a>
    </div>
</section>

<section class="metrics-grid page-section">
    <article class="metric-card metric-card--blue">
        <span class="metric-card__label">Tổng POI</span>
        <strong class="metric-card__value">@Model.TotalCount</strong>
    </article>
    <article class="metric-card metric-card--green">
        <span class="metric-card__label">Đang hoạt động</span>
        <strong class="metric-card__value">@Model.ActiveCount</strong>
    </article>
    <article class="metric-card metric-card--orange">
        <span class="metric-card__label">Chờ duyệt</span>
        <strong class="metric-card__value">@Model.PendingCount</strong>
    </article>
    <article class="metric-card metric-card--blue">
        <span class="metric-card__label">Đã duyệt</span>
        <strong class="metric-card__value">@Model.ApprovedCount</strong>
    </article>
    <article class="metric-card metric-card--red">
        <span class="metric-card__label">Bị từ chối</span>
        <strong class="metric-card__value">@Model.RejectedCount</strong>
    </article>
</section>

<section class="card-surface page-section">
    <div class="section-heading">
        <h2>Tìm kiếm và lọc</h2>
    </div>

    <form method="get" class="search-grid">
        <div class="search-grid__wide">
            <label class="form-label" for="query">Tên, địa chỉ, điện thoại, mã QR</label>
            <input id="query" name="query" class="form-control" value="@Model.Query"
                   placeholder="Ví dụ: Ốc Oanh, Vĩnh Khánh, poi:oc-oanh..." />
        </div>
        <div>
            <label class="form-label" for="approvalStatus">Trạng thái duyệt</label>
            <select id="approvalStatus" name="approvalStatus" class="form-select">
                <option value="">Tất cả</option>
                <option value="@PoiApprovalStatus.Pending"
                        selected="@(Model.ApprovalStatus == PoiApprovalStatus.Pending)">Chờ duyệt</option>
                <option value="@PoiApprovalStatus.Approved"
                        selected="@(Model.ApprovalStatus == PoiApprovalStatus.Approved)">Đã duyệt</option>
                <option value="@PoiApprovalStatus.Rejected"
                        selected="@(Model.ApprovalStatus == PoiApprovalStatus.Rejected)">Bị từ chối</option>
            </select>
        </div>
        <div class="search-actions">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>
</section>

<section class="card-surface page-section">
    <div class="section-heading">
        <h2>Danh sách POI</h2>
        <span class="soft-pill soft-pill--neutral">@Model.TotalItems kết quả</span>
    </div>

    @if (!pois.Any())
    {
        <div class="empty-state">
            <p>Chưa có dữ liệu POI.</p>
        </div>
    }
    else
    {
        <div class="inventory-grid">
            @foreach (var poi in pois)
            {
                var languages = GetLanguageCodes(poi);
                var normalizedStatus = PoiApprovalStatus.Normalize(poi.ApprovalStatus);
                <article class="inventory-card">
                    <div class="inventory-card__media">
                        @if (!string.IsNullOrWhiteSpace(poi.ImageUrl))
                        {
                            <img src="@ResolveImageUrl(poi.ImageUrl)" alt="@poi.Name" />
                        }
                        else
                        {
                            <div class="inventory-card__placeholder">POI</div>
                        }
                    </div>

                    <div class="inventory-card__body">
                        <div class="inventory-card__header">
                            <div>
                                <div class="inventory-card__title">@poi.Name</div>
                                <div class="inventory-card__meta">@poi.Address</div>
                                @if (!string.IsNullOrWhiteSpace(poi.PhoneNumber))
                                {
                                    <div class="inventory-card__meta">@poi.PhoneNumber</div>
                                }
                            </div>
                            <div class="pill-cloud">
                                @RenderApprovalStatus(poi)
                                @if (poi.IsActive && PoiApprovalStatus.IsApproved(poi.ApprovalStatus))
                                {
                                    <span class="status-pill status-pill--success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--muted">Đang ẩn</span>
                                }
                            </div>
                        </div>

                        <div class="inventory-card__stats">
                            <div class="inventory-stat">
                                <strong>Tọa độ</strong>
                                <span class="mono">@poi.Latitude.ToString("0.########"),
                                    @poi.Longitude.ToString("0.########")</span>
                                </div>
                                <div class="inventory-stat">
                                    <strong>Bán kính</strong>
                                    <span>@poi.RadiusMeters.ToString("0.#") m</span>
                                </div>
                                <div class="inventory-stat">
                                    <strong>Ngày gửi</strong>
                                    <span>@(poi.SubmittedAt.HasValue? WebDisplayTime.Format(poi.SubmittedAt.Value, "dd/MM/yyyy HH:mm") : "-")</span>
                                </div>
                                <div class="inventory-stat">
                                    <strong>Ngày duyệt</strong>
                                    <span>@(poi.ReviewedAt.HasValue? WebDisplayTime.Format(poi.ReviewedAt.Value, "dd/MM/yyyy HH:mm")
                                                                : "-")</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(poi.ReviewNote))
                                {
                                    <div class="alert alert-warning mt-3 mb-0">
                                        <strong>Lý do từ chối:</strong> @poi.ReviewNote
                                    </div>
                                }

                                <div class="pill-cloud mt-3">
                                    @foreach (var lang in languages)
                                    {
                                        <span class="lang-pill">@lang</span>
                                    }
                                </div>

                                <div class="inventory-card__actions">
                                    @if (Model.IsAdmin && normalizedStatus == PoiApprovalStatus.Pending)
                                    {
                                        <form asp-action="Approve" asp-route-id="@poi.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-primary btn-sm">Phê duyệt</button>
                                        </form>

                                        <details class="reject-panel">
                                            <summary class="reject-panel__toggle">Từ chối</summary>
                                            <div class="reject-panel__body">
                                                <div class="reject-panel__hint">Lý do từ chối</div>
                                                <form asp-action="Reject" asp-route-id="@poi.Id" method="post" class="reject-panel__form">
                                                    @Html.AntiForgeryToken()
                                                    <textarea name="reviewNote" class="form-control" rows="3"
                                                              placeholder="Ví dụ: Thiếu ảnh đại diện, tọa độ chưa chính xác, nội dung TTS còn quá ngắn..."
                                                              required></textarea>
                                                    <div class="reject-panel__actions">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">Xác nhận từ
                                                            chối</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </details>
                                        }

                                        @if (!Model.IsAdmin && normalizedStatus == PoiApprovalStatus.Rejected)
                                        {
                                            <a asp-action="Edit" asp-route-id="@poi.Id" class="btn btn-warning btn-sm">Sửa và gửi lại</a>
                                        }

                                        <button type="button" class="audio-preview-button" data-audio="@VietnameseAudio(poi)"
                                                data-text="@poi.TtsScriptVi" data-title="@poi.Name" aria-label="Nghe thử @poi.Name">
                                            <span class="audio-preview-button__icon" aria-hidden="true"></span>
                                            <span>Nghe thử</span>
                                        </button>
                                        <a asp-action="Edit" asp-route-id="@poi.Id" class="btn btn-outline-secondary btn-sm">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@poi.Id" class="btn btn-outline-danger btn-sm">Xóa</a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                    <partial name="_Pagination"
                             model="@(new VKFoodArea.Web.ViewModels.PaginationViewModel { Page = Model.Page, PageSize = Model.PageSize, TotalItems = Model.TotalItems })" />
                }
            </section>

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RenderApprovalStatus(Poi poi)
    {
        var status = PoiApprovalStatus.Normalize(poi.ApprovalStatus);
        var label = PoiApprovalStatus.DisplayName(status);
        var cssClass = status switch
        {
            PoiApprovalStatus.Pending => "status-pill status-pill--info",
            PoiApprovalStatus.Rejected => "status-pill status-pill--muted",
            _ => "status-pill status-pill--success"
        };

        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"{cssClass}\">{label}</span>");
    }

    private static List<string> GetLanguageCodes(Poi poi)
    {
        var result = new List<string>();

        if (!string.IsNullOrWhiteSpace(poi.TtsScriptVi)) result.Add("VI");
        if (!string.IsNullOrWhiteSpace(poi.TtsScriptEn)) result.Add("EN");
        if (!string.IsNullOrWhiteSpace(poi.TtsScriptZh)) result.Add("ZH");
        if (!string.IsNullOrWhiteSpace(poi.TtsScriptJa)) result.Add("JA");
        if (!string.IsNullOrWhiteSpace(poi.TtsScriptDe)) result.Add("DE");

        return result;
    }

    private static string VietnameseAudio(Poi poi)
        => string.IsNullOrWhiteSpace(poi.AudioFileVi) ? string.Empty : poi.AudioFileVi;

    private static string ResolveImageUrl(string? imageUrl)
    {
        var normalized = (imageUrl ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized))
            return string.Empty;

        if (Uri.TryCreate(normalized, UriKind.Absolute, out _))
            return normalized;

        if (normalized.StartsWith("/", StringComparison.Ordinal))
            return normalized;

        if (normalized.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
            return $"/{normalized.TrimStart('/')}";

        return $"/uploads/poi-images/{System.IO.Path.GetFileName(normalized)}";
    }
}

@section Scripts {
    <script>
        (() => {
            let currentAudio = null;

            document.querySelectorAll(".audio-preview-button").forEach((button) => {
                button.addEventListener("click", () => {
                    const audioUrl = button.dataset.audio || "";
                    const text = button.dataset.text || "";

                    if (currentAudio) {
                        currentAudio.pause();
                        currentAudio = null;
                    }

                    if (window.speechSynthesis) {
                        window.speechSynthesis.cancel();
                    }

                    if (audioUrl) {
                        currentAudio = new Audio(audioUrl);
                        currentAudio.play().catch(() => {
                            button.classList.add("audio-preview-button--error");
                        });
                        return;
                    }

                    if (text && window.speechSynthesis) {
                        const utterance = new SpeechSynthesisUtterance(text);
                        utterance.lang = "vi-VN";
                        utterance.rate = 0.9;
                        utterance.pitch = 0.95;
                        window.speechSynthesis.speak(utterance);
                    }
                });
            });
        })();
    </script>
}
